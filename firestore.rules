rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users — each user manages their own profile; admins can manage anyone
    match /users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Schools — readable by all signed-in users, only admins can modify
    match /schools/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admission requirements — readable by all signed-in students,
    // only admins can modify (per-school programmes + cut-off scores)
    match /admission_requirements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Applications — students create and manage their own; admins manage all
    //
    // get/update/delete use resource.data (no extra read) to check ownership.
    // list is open to signed-in users so Firestore doesn't need a per-doc get()
    // during the query; the client always filters by userId so only the owner's
    // docs are returned.
    match /applications/{id} {
      allow create: if isSignedIn();
      allow list: if isSignedIn();
      allow get, update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Application documents (base64 images) — owner + admin only
    match /applications/{id}/documents/{docId} {
      allow list: if isSignedIn();
      allow get: if isAdmin() ||
        (isSignedIn() && get(/databases/$(database)/documents/applications/$(id)).data.userId == request.auth.uid);
      allow write: if isSignedIn() &&
        get(/databases/$(database)/documents/applications/$(id)).data.userId == request.auth.uid;
    }

    // Notifications — admins create them for students; students read/update/delete their own
    match /notifications/{id} {
      allow create: if isAdmin();
      allow list: if isSignedIn();
      allow get, update, delete:
        if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Favorites — students manage their own saved schools
    match /favorites/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow list: if isSignedIn();
      allow get, update, delete:
        if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
